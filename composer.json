{
    "name": "kustom/module-support",
    "description": "Kustom Support Magento 2 Extension",
    "type": "magento2-module",
    "license": "Apache-2.0",
    "version": "3.1.1",
    "scripts": {
        "test": "phpunit",
        "cov": "phpunit --coverage-html coverage"
    },
    "require": {
        "kustom/module-base": "^11.0 || ^12.0",
        "magento/framework": "^103",
